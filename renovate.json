{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "separateMinorPatch": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ]
  },
  "homeassistant-manifest": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchPackageNames": [
        "pre-commit",
        "pyright",
        "pytest-cov",
        "ruff"
      ],
      "groupName": "python dev tools"
    },
    {
      "matchPackageNames": [
        "ignazhabibi/vi_api_client"
      ],
      "groupName": "vi_api_client"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)pyproject\\.toml$/",
        "/(^|/)custom_components/vi_climate_devices/manifest\\.json$/"
      ],
      "matchStrings": [
        "vi_api_client @ git\\+https://github\\.com/(?<depName>[^/]+/[^.]+)\\.git@(?<currentValue>v[^\"\\s,\\]]+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
