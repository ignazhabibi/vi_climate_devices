{
    "application_credentials": {
        "description": "Enter your Viessmann client ID. Home Assistant requires a value in the client secret field; enter any placeholder. The integration ignores it because Viessmann uses PKCE without a client secret."
    },
    "config": {
        "step": {
            "user": {
                "title": "Connect to Viessmann Heat",
                "description": "Click the link below to authenticate with Viessmann."
            },
            "reauth_confirm": {
                "title": "Re-authenticate with Viessmann",
                "description": "Your Viessmann session has expired. Please re-authenticate to restore the connection."
            },
            "validate": {
                "title": "Verify Viessmann access",
                "description": "Home Assistant must verify that this account can access at least one Viessmann installation. Fix the problem shown below, then try again."
            }
        },
        "error": {
            "invalid_auth": "Viessmann rejected the new access token. Try signing in again.",
            "cannot_connect": "Unable to reach the Viessmann service. Check your internet connection and try again.",
            "no_installations": "This Viessmann account cannot access any installations. Add or share an installation with this account, then try again.",
            "unknown": "Unable to verify access to Viessmann. Try again later."
        },
        "abort": {
            "reauth_successful": "Re-authentication was successful",
            "unknown": "An unexpected error occurred. Start the setup again."
        }
    },
    "exceptions": {
        "feature_unavailable": {
            "message": "This control is currently unavailable."
        },
        "unsupported_mode": {
            "message": "The requested operating mode is not supported."
        },
        "command_rejected": {
            "message": "Viessmann rejected the requested command."
        },
        "temperature_change_failed": {
            "message": "Unable to change the temperature."
        },
        "mode_change_failed": {
            "message": "Unable to change the operating mode."
        },
        "selection_failed": {
            "message": "Unable to change the selected option."
        },
        "switch_operation_failed": {
            "message": "Unable to change the switch state."
        },
        "number_change_failed": {
            "message": "Unable to change the value."
        },
        "authentication_failed": {
            "message": "Viessmann authentication failed. Please re-authenticate."
        },
        "setup_not_ready": {
            "message": "Viessmann is temporarily unavailable. Home Assistant will retry setup."
        }
    },
